      #ifdef LAYER_Factory
      Factory {
        bindings = <
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          RED ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
                  ___ ___ ___                                     ___ ___ ___
                                  ___ ___ ___     ___ ___ ___
        >;
