      #endif

      #ifdef LAYER_Mouse
      Mouse {
        bindings = <
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ SPG AZU SPG ___                             GDN GDN GDN GDN GDN ___
          ___ SPG AZU AZU AZU SPG                             SPG FST WRP SLO PUR SPG
          ___ SPG SLO WRP FST SPG                             SPG AZU AZU AZU AZU SPG
                  BLU BLU BLU                                     YLW GRN CYN
                                  GDN GDN GDN     ___ RED ___
        >;
        layer-id = <LAYER_Mouse>;
