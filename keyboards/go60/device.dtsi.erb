  / {
    underglow-layer {
      compatible  = "zmk,underglow-layer";

  // ZMK only cares about the order of bindings (checked with https://github.com/moergo-keyboards/go60-zmk-config/blob/main/config/go60.keymap)
  /*
      Template {
        bindings = <
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
                  ___ ___ ___                                     ___ ___ ___
                                  ___ ___ ___     ___ ___ ___
        >;
        layer-id = <LAYER_Template>;
      };
      */

   // TODO: Not sure what the LH T colors mean
   BaseLayer {
        bindings = <
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ MAJ CYN GRN YLW ___                             ___ YLW GRN CYN MAJ ___
          YLW ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ YLW
                  ___ ___ LAC                                     LAC ___ ___
                                  BSL BNL BCL     LAC LAC LAC
        >;
        layer-id = <0>;
      };


      #ifdef LAYER_Cursor
      Cursor {
        bindings = <
          ___ COR COR COR COR ___                             ___ ___ ___ ___ ___ ___
          ___ COR COR COR COR GDN                             GDN COR PUR PUR COR ___
          YLW MAJ CYN GRN YLW GDN                             GDN AZU AZU AZU AZU YLW
          PNK SPG SPG SPG PUR GDN                             GDN AZU AZU AZU AZU PNK
                  PUR PUR PUR                                     PUR PUR PUR
                                  RED COR COR     SPG SPG SPG
        >;
        layer-id = <LAYER_Cursor>;
      };
      #endif

      #ifdef LAYER_Number
      Number {
        bindings = <
          ___ COR COR COR COR ___                             TEA SPG SPG SPG SPG SPG
          ___ COR COR COR COR GOL                             TEA GOL GOL GOL SPG SPG
          YLW MAJ CYN GRN YLW TEA                             TEA GOL GOL GOL SPG SPG
          TEA SPG SPG SPG PUR GDN                             TEA GOL GOL GOL SPG SPG
                  PUR PUR PUR                                     SPG SPG SPG
                                  ___ RED ___     SPG SPG GOL
        >;
        layer-id = <LAYER_Number>;
      };
      #endif

      #ifdef LAYER_Function
      Function {
        bindings = <
          ___ COR COR COR COR ___                             AZU AZU AZU AZU AZU AZU
          ___ COR COR COR COR GDN                             GDN PNK PNK PNK PNK PNK
          YLW MAJ CYN GRN YLW GDN                             GDN PNK PNK PNK PNK PNK
          ___ SPG SPG SPG PUR GDN                             GDN PNK PNK PNK PNK PNK
                  PUR PUR PUR                                     CHU CHU CHU
                                  ___ ___ ___     AZU AZU AZU
        >;
        layer-id = <LAYER_Function>;
      };
      #endif

      #ifdef LAYER_Emoji
      Emoji {
        bindings = <
          ___ ___ ___ ___ ___ ___                             ___ CYN ___ ___ CYN ___
          ___ ___ ___ ___ ___ ___                             ___ ___ ___ ___ ___ ___
          ___ GDN PNK SPG AZU ___                             CYN ___ ___ ___ ___ CYN
          ___ ___ ___ ___ ___ ___                             ___ CYN ___ ___ CYN ___
                  ___ ___ RED                                     ___ CYN CYN
                                  YLW ___ ___     ___ ___ ___
        >;
        layer-id = <LAYER_Emoji>;
      };
      #endif

            #ifdef LAYER_Symbol
      Symbol {
        bindings = <
          COR PNK AZU AZU CHU CHU                             ___ ___ ___ ___ ___ ___
          PUR AZU AZU AZU AZU GDN                             CHU COR COR COR COR ___
          GDN GDN SPG BLU GDN GDN                             CHU COR COR COR COR ___
          PUR SPG SPG SPG SPG GDN                             CHU PNK PNK PNK PUR YLW
                  PNK PNK BLU                                     YLW GRN CYN
                                  GDN GDN GDN     ___ ___ RED
        >;
        layer-id = <LAYER_Symbol>;
