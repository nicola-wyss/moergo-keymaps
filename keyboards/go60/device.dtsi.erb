        bindings = <
          ___ GDN GDN GDN GDN GDN                             TEA TEA TEA TEA TEA TEA
          ___ GDN GDN GDN GDN GDN                             ___ ___ ___ ___ ___ TEA
          ___ COR ___ AZU ___ ___                             ___ ___ ___ ___ ___ ___
          ___ YLW AZU AZU AZU RED                             ___ ___ ___ ___ ___ ___
